{
  "name": "Webhook",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Webhook Name"
    },
    "url": {
      "type": "string",
      "title": "Endpoint URL"
    },
    "events": {
      "type": "array",
      "title": "Events",
      "items": {
        "type": "string",
        "enum": [
          "price_drop",
          "wishlist_add",
          "shoe_search",
          "new_deal",
          "price_track_add"
        ]
      }
    },
    "is_active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    },
    "secret": {
      "type": "string",
      "title": "Secret Token"
    },
    "last_triggered": {
      "type": "string",
      "title": "Last Triggered"
    },
    "trigger_count": {
      "type": "number",
      "title": "Total Triggers",
      "default": 0
    },
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    }
  },
  "required": [
    "name",
    "url"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}