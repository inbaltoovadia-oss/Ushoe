{
  "name": "PriceTrack",
  "type": "object",
  "properties": {
    "shoe_id": {
      "type": "string",
      "title": "Shoe ID"
    },
    "shoe_name": {
      "type": "string",
      "title": "Shoe Name"
    },
    "shoe_brand": {
      "type": "string",
      "title": "Shoe Brand"
    },
    "shoe_image": {
      "type": "string",
      "title": "Shoe Image URL"
    },
    "tracked_price": {
      "type": "number",
      "title": "Price at Time of Tracking"
    },
    "current_price": {
      "type": "number",
      "title": "Current Price"
    },
    "category": {
      "type": "string",
      "title": "Category"
    },
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    }
  },
  "required": [
    "shoe_id",
    "shoe_name",
    "tracked_price"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}