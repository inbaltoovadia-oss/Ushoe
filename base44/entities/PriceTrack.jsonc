{
  "name": "PriceTrack",
  "type": "object",
  "properties": {
    "shoe_id": {
      "type": "string",
      "title": "Shoe ID"
    },
    "shoe_name": {
      "type": "string",
      "title": "Shoe Name"
    },
    "shoe_brand": {
      "type": "string",
      "title": "Shoe Brand"
    },
    "shoe_image": {
      "type": "string",
      "title": "Shoe Image URL"
    },
    "tracked_price": {
      "type": "number",
      "title": "Price at Time of Tracking"
    },
    "current_price": {
      "type": "number",
      "title": "Current Price"
    },
    "target_price": {
      "type": "number",
      "title": "Target Alert Price"
    },
    "alert_sent_at": {
      "type": "string",
      "title": "Last Alert Sent At",
      "format": "date-time"
    },
    "category": {
      "type": "string",
      "title": "Category"
    },
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    }
  },
  "required": [
    "shoe_id",
    "shoe_name",
    "tracked_price"
  ]
}