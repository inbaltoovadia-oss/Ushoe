{
  "name": "Shoe",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "brand": {
      "type": "string",
      "title": "Brand"
    },
    "model": {
      "type": "string",
      "title": "Model"
    },
    "category": {
      "type": "string",
      "title": "Category",
      "enum": [
        "Running",
        "Casual",
        "Basketball",
        "Lifestyle",
        "Training",
        "Walking",
        "Tennis",
        "Cleats",
        "Sandals",
        "Flip Flops",
        "Slides",
        "Crocs & Clogs",
        "Hiking",
        "Skateboarding",
        "Golf"
      ]
    },
    "price": {
      "type": "number",
      "title": "Price"
    },
    "original_price": {
      "type": "number",
      "title": "Original Price"
    },
    "image_url": {
      "type": "string",
      "title": "Image URL"
    },
    "image_locked": {
      "type": "boolean",
      "title": "Image Locked (manually selected)",
      "default": false
    },
    "colorway": {
      "type": "string",
      "title": "Colorway"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "features": {
      "type": "array",
      "title": "Features",
      "items": {
        "type": "string"
      }
    },
    "rating": {
      "type": "number",
      "title": "Rating"
    },
    "trending_score": {
      "type": "number",
      "title": "Trending Score"
    },
    "sizes_available": {
      "type": "array",
      "title": "Sizes Available",
      "items": {
        "type": "number"
      }
    },
    "colors_available": {
      "type": "array",
      "title": "Colors Available",
      "items": {
        "type": "string"
      }
    },
    "gender": {
      "type": "string",
      "title": "Gender",
      "enum": [
        "Men",
        "Women",
        "Unisex"
      ]
    },
    "release_date": {
      "type": "string",
      "title": "Release Date",
      "format": "date"
    },
    "is_trending": {
      "type": "boolean",
      "title": "Is Trending"
    },
    "is_sponsored": {
      "type": "boolean",
      "title": "Is Sponsored",
      "default": false
    },
    "sponsored_plan": {
      "type": "string",
      "title": "Sponsored Plan",
      "enum": [
        "starter",
        "featured",
        "premium"
      ]
    },
    "sponsored_until": {
      "type": "string",
      "title": "Sponsored Until",
      "format": "date-time"
    }
  },
  "required": [
    "name",
    "brand",
    "price",
    "image_url",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}