{
  "name": "WishlistItem",
  "type": "object",
  "properties": {
    "shoe_id": {
      "type": "string",
      "title": "Shoe ID"
    },
    "shoe_name": {
      "type": "string",
      "title": "Shoe Name"
    },
    "shoe_brand": {
      "type": "string",
      "title": "Shoe Brand"
    },
    "shoe_image": {
      "type": "string",
      "title": "Shoe Image"
    },
    "shoe_price": {
      "type": "number",
      "title": "Shoe Price"
    },
    "price_alert": {
      "type": "boolean",
      "title": "Price Alert Enabled"
    },
    "alert_price": {
      "type": "number",
      "title": "Alert Price"
    },
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    }
  },
  "required": [
    "shoe_id",
    "shoe_name",
    "shoe_price"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}