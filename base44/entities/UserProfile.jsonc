{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "preferred_brands": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Preferred Brands"
    },
    "budget_max": {
      "type": "number",
      "title": "Max Budget"
    },
    "main_use": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Main Use Categories"
    },
    "style_preference": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Style Preferences"
    },
    "gender": {
      "type": "string",
      "title": "Gender",
      "enum": [
        "Men",
        "Women",
        "Unisex"
      ]
    },
    "survey_completed": {
      "type": "boolean",
      "title": "Survey Completed",
      "default": false
    },
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    }
  },
  "required": []
}